{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "packages": [
    "npm:@banh-me/pi-model-costs",
    "npm:@banh-me/pi-vim",
    "npm:@ff-labs/pi-fff",
    "npm:@juicesharp/rpiv-advisor",
    "npm:@juicesharp/rpiv-web-tools",
    "npm:@mrclrchtr/supi-ask-user",
    "npm:@sting8k/pi-vcc",
    "npm:pi-freeflow",
    "npm:pi-subagents-lite"
  ],
  "defaultProvider": "phoenix-grove",
  "defaultModel": "deepseek-v4.1-flash-1017",
  "defaultTools": ["+codemode"],
  "doubleEscapeAction": "tree",
  "enableInstallTelemetry": false,
  "lastChangelogVersion": "1.4.0",
  "showHardwareCursor": true,
  "theme": "matugen",
  "hideThinkingBlock": true,
  "piVim": {
    "enabled": true,
    "clipboardMirror": "yank",
    "initial_mode": "insert",
    "langmap": {
      "H": "^",
      "L": "$"
    },
    "escape_sequence": "jk",
    "enter_submit": true,
    "insert_after_submit": true,
    "cursor_shape": {
      "normal": "block",
      "insert": "bar",
      "replace": "underline",
      "visual": "block",
      "visualLine": "block"
    }
  }
}
