{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "packages": [
    "npm:@bacnh85/pi-notify",
    "npm:@banh-me/pi-vim",
    "npm:@ff-labs/pi-fff",
    "npm:@juicesharp/rpiv-advisor",
    "npm:@juicesharp/rpiv-web-tools",
    "npm:@mrclrchtr/supi-ask-user",
    "npm:@sting8k/pi-vcc",
    "npm:pi-freeflow",
    "npm:pi-subagents-lite"
  ],
  "defaultProvider": "infron",
  "defaultModel": "deepseek/deepseek-v4.1-flash:free",
  "defaultTools": ["+codemode"],
  "doubleEscapeAction": "tree",
  "enableInstallTelemetry": false,
  "lastChangelogVersion": "1.3.0",
  "showHardwareCursor": true,
  "theme": "matugen",
  "hideThinkingBlock": true,
  "notify": {
    "onComplete": true,
    "onError": false,
    "onQuestion": true,
    "sound": true,
    "volume": 0.2
  },
  "piVim": {
    "enabled": true,
    "clipboardMirror": "yank",
    "initial_mode": "insert",
    "langmap": {
      "H": "^",
      "L": "$"
    },
    "escape_sequence": "jk",
    "enter_submit": true,
    "insert_after_submit": true
  }
}
