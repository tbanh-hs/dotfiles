# Only run side effects during `brew bundle` or `brew bundle install`,
# not during `check`, `list`, `dump`, `cleanup`, or `exec`.
def installing?
  ARGV.empty? || ARGV.any? { |arg| arg == "install" }
end

cask "ghostty"
cask "wezterm"

# Yazi + dependencies
brew "fd"
brew "ffmpeg-full", link: true
cask "font-symbols-only-nerd-font"
brew "fzf"
brew "imagemagick-full", link: true
brew "jq"
brew "poppler"
brew "resvg"
brew "ripgrep"
brew "sevenzip"
brew "yazi"
brew "zoxide"

tap "anomalyco/tap"
brew "anomalyco/tap/opencode"

tap "raine/workmux"
brew "raine/workmux/workmux"

brew "atuin"
brew "bat"
brew "btop"
brew "chezmoi"
brew "eza"
brew "gh"
brew "git"
brew "git-delta"
brew "lazygit"
brew "llama.cpp"
brew "neovim"
brew "node"
brew "sesh"
brew "starship"
brew "tmux"
brew "uv"

# Non-brew packages, mac AND linux
if installing?
  # Oh My Zsh
  system 'sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended' unless Dir.exist?("#{ENV["HOME"]}/.oh-my-zsh")
  zsh_custom = ENV["ZSH_CUSTOM"] || "#{ENV["HOME"]}/.oh-my-zsh/custom"
  {
    "zsh-completions"              => "https://github.com/zsh-users/zsh-completions.git",
    "zsh-vi-mode"                  => "https://github.com/jeffreytse/zsh-vi-mode",
  }.each do |name, url|
    dest = "#{zsh_custom}/plugins/#{name}"
    system "git clone #{url} #{dest}" unless Dir.exist?(dest)
  end

  # Rust + cargo
  cargo_bin = "#{ENV["HOME"]}/.cargo/bin"
  system 'curl --proto "=https" --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y' unless File.exist?("#{cargo_bin}/rustup")

  if File.exist?("#{cargo_bin}/cargo")
    system "#{cargo_bin}/cargo install matugen --registry crates-io"
  else
    warn "Skipping matugen: cargo not found. Install the Rust toolchain (rustup) first."
  end

  # Paseo CLI
  system "npm install -g @getpaseo/cli"
end

if OS.mac?
  brew "reattach-to-user-namespace"
  cask "raycast"

  tap "FelixKratz/formulae"
  brew "borders", restart_service: :changed
end

if OS.linux?
  brew "zsh"
  brew "resterm"

  if installing?
    system "yay -S portmaster-bin"
    system "yay -S vicinae-bin"
    system "sudo pacman -S libnotify"
  end
end
