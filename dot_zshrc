# Put brew env variable and eval in .zprofile, which gets loaded before .zshrc
## troubleshooting:
### deno/bun prepend to PATH on install — inspect spill: `echo $PATH | tr ':' '\n'`
### rebuild completion dump: `rm ~/.zcompdump*` (oh-my-zsh regenerates next shell)
### fix "insecure completion directories": `chmod -R go-w "$(brew --prefix)/share"`
### trace rc sourcing / profile startup: `PS4='+%T %N:%i> ' zsh -xilc 'exit' 2>/tmp/zsh-trace.log`

if command -v mise &>/dev/null; then
  eval "$(mise activate zsh)"
fi

if command -v starship &>/dev/null; then
  eval "$(starship init zsh)"
  export STARSHIP_CONFIG="$HOME/.config/starship/starship.toml"
fi

if command -v wt >/dev/null 2>&1; then
  eval "$(command wt config shell init zsh)"
fi

export ZSH="$HOME/.oh-my-zsh"

# oh-my-zsh settings: https://github.com/ohmyzsh/ohmyzsh/wiki/Settings
# zstyle ':omz:update' mode auto        # alternatives: disabled, reminder
# zstyle ':omz:update' frequency 13

# ===================

# PLUGINS MANAGEMENT

plugins=(
  ## External (requires git clone; add to brewfile)
  zsh-completions
  zsh-vi-mode

  # OMZ built-in
  ssh-agent
  zsh-autosuggestions
  zsh-syntax-highlighting
)

update_zsh_plugins() {
  # external (non-OMZ) plugins cloned into $ZSH_CUSTOM/plugins.
  local dir before
  for dir in "${ZSH_CUSTOM:-$ZSH/custom}"/plugins/*(/N); do
    [[ -d "$dir/.git" ]] || continue
    before="$(git -C "$dir" rev-parse HEAD)"
    if ! git -C "$dir" pull --ff-only -q 2>/dev/null; then
      print "ff-update failed for ${dir:t}; removing for clean re-clone" >&2
      rm -rf "$dir"
      continue
    fi
    [[ "$before" == "$(git -C "$dir" rev-parse HEAD)" ]] || print "${dir:t}: updated"
  done
  # internal (OMZ) plugins
  omz update
}

