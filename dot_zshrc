## Chezmoi
cm() {
  if [[ "$1" == "add" || "$1" == "forget" || "$1" == "re-add" ]]; then
    chezmoi "$@" || return $?
    if [[ -d ~/dotfiles-work ]]; then
      chezmoi -S ~/dotfiles-work "$@"
    fi
  else
    chezmoi "$@"
  fi
}

## Yazi - https://yazi-rs.github.io/docs/quick-start
### Changes cwd when exiting yazi
### `y` to start, `q` to quit and have CWD change, `Q` to quit
function y() {
  local tmp cwd
  tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
  command yazi "$@" --cwd-file="$tmp"
  cwd="$(command cat -- "$tmp")"
  [ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd" || builtin true
  command rm -f -- "$tmp"
}

# See: https://github.com/atuinsh/atuin/issues/977
function zvm_after_init() {
  [ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

  # Atuin (install with brew wherever possible)
  if command -v atuin &>/dev/null; then
    eval "$(atuin init zsh)"
    zvm_bindkey vicmd '^R' atuin-search
  fi
}

